{
  "name": "@genlayer/transaction-kit",
  "version": "0.1.0-rc.1",
  "description": "Framework-agnostic GenLayer transaction policy, submission, tracking, and verification helpers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --splitting false --clean",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "genlayer-js": "2.0.0-rc.1"
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genlayerlabs/genlayer-transaction-kit.git",
    "directory": "packages/core"
  }
}
