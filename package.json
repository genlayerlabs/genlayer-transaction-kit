{
  "name": "genlayer-transaction-kit",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:packages && npm run test:release",
    "test:packages": "npm run test --workspaces --if-present",
    "test:release": "node --test scripts/*.test.mjs",
    "pretypecheck": "npm run build --workspace @genlayer/transaction-kit",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pack:check": "node scripts/check-packages.mjs",
    "release:check": "node scripts/check-release.mjs"
  }
}
